<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SandboxProbe.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SandboxProbe"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="32" Spacing="16">
        <TextBlock Text="WinUI 3 Sandbox Probe" FontSize="28" />
        <TextBlock Text="Click the button to verify UI automation." />
        <TextBlock Text="User:" />
        <TextBlock x:Name="EnvironmentText" AutomationProperties.AutomationId="EnvironmentText" />
        <Button Content="Verify interaction"
                AutomationProperties.AutomationId="VerifyButton"
                Click="VerifyButton_Click" />
        <TextBlock x:Name="StatusText" Text="Ready: 0 clicks"
                   AutomationProperties.AutomationId="StatusText" />
    </StackPanel>
</Page>
